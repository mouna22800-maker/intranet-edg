# ============================================================================
#  Modèle de configuration — Intranet Électricité de Guinée (EDG)
#  Copiez ce fichier en ".env" et renseignez les valeurs. NE COMMITEZ JAMAIS ".env".
# ============================================================================

# --- Environnement ---
# "development" (défaut) ou "production".
# En "production" : /docs et /redoc désactivés, en-tête HSTS activé, et le garde-fou
# du secret JWT refuse de démarrer si JWT_SECRET_KEY n'est pas défini.
APP_ENV="development"

# --- Base de données MySQL ---
# DB_TYPE="mysql" (application). "sqlite" est réservé aux tests automatisés.
DB_TYPE="mysql"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
# EN PRODUCTION : créez un utilisateur MySQL dédié (PAS root), avec un mot de passe fort
# et des droits limités à la base edg_intranet uniquement.
MYSQL_USER="edg_app"
MYSQL_PASSWORD="CHANGEZ_MOI_mot_de_passe_fort"
MYSQL_DATABASE="edg_intranet"

# --- Sécurité / session ---
# Secret de signature des jetons de session. OBLIGATOIRE en production.
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="CHANGEZ_MOI_generez_un_secret_de_64_caracteres"

# EN PRODUCTION (HTTPS) : mettre "true" pour que le cookie de session ne circule qu'en HTTPS.
# En dev local (HTTP), laisser "false" sinon le cookie n'est pas posé.
COOKIE_SECURE="false"

# --- Administrateur initial (production uniquement) ---
# En APP_ENV=production, AUCUN compte de démonstration n'est créé. Au tout premier
# démarrage, un administrateur unique est provisionné avec CETTE adresse et un mot de
# passe ALÉATOIRE affiché une seule fois dans le journal du serveur ; le changement est
# obligatoire à la première connexion. Adaptez l'adresse à votre organisation.
ADMIN_EMAIL="admin@edg.com.gn"

# --- CORS ---
# Origines autorisées à appeler l'API, séparées par des virgules.
# En prod, mettre UNIQUEMENT le domaine réel, ex : "https://intranet.edg.com.gn"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- URL publique de l'application (pour les liens dans les e-mails, ex. réinitialisation) ---
APP_URL="http://localhost:3000"

# --- E-mail (SMTP) : requis pour la fonctionnalité "mot de passe oublié" ---
# Si SMTP_HOST est vide, aucun e-mail n'est envoyé (le lien de reset est seulement journalisé côté serveur).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@edg.com.gn"
# "true" = STARTTLS (port 587) ; "false" = SSL direct (port 465)
SMTP_TLS="true"
